"""{{name}} の設計パラメータ。事前計算と CAD 生成の両方がここから読む（設計値の置き場所はここだけ）。

大文字の名前は、そのまま SOLIDWORKS のグローバル変数になる。単位は mm、kg。
値の根拠をコメントに書く: [要求] 仕様で決まる値、[図面] メーカーの図面の値、[計算] 事前計算で決めた値、[仮] 未確定の値。
"""
from dataclasses import dataclass


@dataclass(frozen=True)
class Mat:
    name: str
    rho: float                           # kg/m3
    E: float = 0.0                       # MPa
    sy: float = 0.0                      # 耐力 MPa
    nu: float = 0.33
    sw: str = ""                         # SOLIDWORKS 材料名。空なら密度だけ設定する


A5052 = Mat("A5052-H32", 2680, 70_000, 195, 0.33, "5052-H32")
SUS304 = Mat("SUS304", 8000, 193_000, 205, 0.29, "AISI 304")

# ---------------------------------------------------------------- 台板（見本）
BASE_L, BASE_W, BASE_T = 120.0, 80.0, 10.0      # [仮] 長さ × 幅 × 板厚（板 t10 の定尺から切り出す）
BASE_R = 5.0                                    # 外周の角 R

# ---------------------------------------------------------------- ブロック（見本）
BLOCK_L, BLOCK_W, BLOCK_H = 60.0, 30.0, 20.0    # [仮]
BOLT_X = 20.0                                   # 固定ボルト M5 の位置 ±
